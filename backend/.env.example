NODE_ENV=development
PORT=3000
# LOG_LEVEL defaults to info (silent when NODE_ENV=test)
# LOG_LEVEL=info

# Browser origins allowed to call the API (admin web app), comma-separated,
# e.g. https://admin.example.com,http://localhost:5173. Empty: none.
CORS_ORIGINS=
# Behind a reverse proxy/load balancer, the number of proxy hops (e.g. 1) or
# their addresses, so client IPs (and the per-IP login limit) are real.
TRUST_PROXY=false

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/AsvaWholesale
# Used when NODE_ENV=test (Jest). Must be a different database; it is truncated between tests.
TEST_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/AsvaWholesale_test

# At least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRY=1d

# cloudinary | local | memory
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
# Required only when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Visit photos are flagged (not rejected) when the camera's EXIF time is off
# from the server clock by more than this, or taken further than this from
# the shop's saved location.
PHOTO_EXIF_MAX_SKEW_MINUTES=10
PHOTO_MAX_DISTANCE_M=150
