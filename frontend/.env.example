# Copy to .env.local and fill in. Every value is optional: src/config.ts has a safe default for each.
# All are NEXT_PUBLIC_ because they are read at build time and end up in the static HTML.

# Public address of this marketing site (canonical URLs, Open Graph, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=https://bitaran.example.com

# Where the "Login" button goes. Leave as /login to use this site's own login pages.
NEXT_PUBLIC_APP_URL=/login

# Where "Request a demo" goes. Leave as /contact to use this site's contact page.
NEXT_PUBLIC_DEMO_URL=/contact

# Contact form endpoint that accepts a POST of form data.
# Leave empty while there is no backend: the form then opens an email and a WhatsApp message instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Contact details. Empty values show as [PLACEHOLDER] on the page.
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Numbers with country code, for example +977 9800000000
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=

# Year shown in the footer.
NEXT_PUBLIC_COPYRIGHT_YEAR=2026

# ---- Login (server-only: never prefix these with NEXT_PUBLIC_) ----

# "mock" uses the built-in test accounts (see README-dev-login.md). "api" uses the real backend.
# A production server refuses to start with mock.
AUTH_MODE=mock

# Signs the session cookie. Leave empty in development to use the documented dev default.
# Production refuses to start without a random value of 32+ characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The real backend's base URL, for when AUTH_MODE=api is wired up (not used yet).
API_URL=
